# OpsPilot AI — Environment Configuration Example

# Project Settings
PROJECT_NAME="OpsPilot AI"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT Auth
SECRET_KEY="generate-a-long-random-secret-key-at-least-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Seed Credentials (LOCAL DEVELOPMENT ONLY - provide your local passwords)
DEMO_ADMIN_PASSWORD="change-me-admin-local-pass"
DEMO_OPS_PASSWORD="change-me-ops-local-pass"
DEMO_REVIEWER_PASSWORD="change-me-reviewer-local-pass"
DEMO_VIEWER_PASSWORD="change-me-viewer-local-pass"
POSTGRES_PASSWORD="change-me-postgres-password"

# Database & Queue
DATABASE_URL="sqlite+aiosqlite:///./opspilot.db"
REDIS_URL="redis://localhost:6379/0"
USE_IN_MEMORY_QUEUE=true

# Storage
STORAGE_TYPE="local"
LOCAL_STORAGE_PATH="./data/storage"
S3_BUCKET_NAME="opspilot-documents"
S3_REGION="us-east-1"
# S3_ENDPOINT_URL=""

# LLM Provider Configuration
DEFAULT_LLM_PROVIDER="mock"
# OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
